# 10. Complete Script Requirements

The final `scripts/data_workflow.py` should follow a structure similar to:

```python
import pandas as pd


def ingest_data(filepath):
    """
    Load raw data from a CSV file.

    Parameters
    ----------
    filepath : str
        Path to the input CSV file.

    Returns
    -------
    pandas.DataFrame
        Raw dataset loaded into a DataFrame.
    """

    # Read the source CSV into memory.
    df = pd.read_csv(filepath)

    return df


def process_data(df):
    """
    Transform raw data into an analysis-ready format.

    Parameters
    ----------
    df : pandas.DataFrame
        Raw input DataFrame.

    Returns
    -------
    pandas.DataFrame
        Cleaned and transformed DataFrame.
    """

    # Remove exact duplicate records.
    df = df.drop_duplicates()

    # Find numerical columns.
    numeric_columns = df.select_dtypes(include=["number"]).columns

    # Replace missing numerical values with their column median.
    for column in numeric_columns:
        df[column] = df[column].fillna(df[column].median())

    return df


def output_results(df, output_path):
    """
    Save processed data to a CSV file.

    Parameters
    ----------
    df : pandas.DataFrame
        Processed DataFrame.

    output_path : str
        Destination path for the output CSV file.

    Returns
    -------
    None
    """

    # Save the processed data without the DataFrame index.
    df.to_csv(output_path, index=False)

    # Display execution confirmation in the terminal.
    print("✓ Data successfully processed")
    print(f"✓ Rows processed: {len(df)}")
    print(f"✓ Output saved to {output_path}")


if __name__ == "__main__":
    # Define the location of the raw input dataset.
    input_path = "data/raw/sample.csv"

    # Define the destination for the processed dataset.
    output_path = "output/processed.csv"

    # Step 1: Load the raw data.
    data = ingest_data(input_path)

    # Step 2: Clean and transform the data.
    processed = process_data(data)

    # Step 3: Save the processed dataset.
    output_results(processed, output_path)
```

The implementation may be extended with additional validation or transformations, but the three core responsibilities must remain clearly separated.

